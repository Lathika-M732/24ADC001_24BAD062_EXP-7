      <column caption='Region Latitude' datatype='integer' name='[Calculation_2136936629338114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [region]&#13;&#10;WHEN &quot;West&quot; THEN 36&#13;&#10;WHEN &quot;Central&quot; THEN 39&#13;&#10;WHEN &quot;East&quot; THEN 39&#13;&#10;WHEN &quot;South&quot; THEN 32&#13;&#10;END' />
