      <column caption='Target Achievement %' datatype='real' name='[Calculation_1948644358008835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / SUM([Sales Target]) * 100' />
      </column>
      <column caption='Sales vs Target Variance' datatype='real' name='[Calculation_1948644358320132]' role='measure' type='quantitative'>
